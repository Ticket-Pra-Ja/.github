{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push * development)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/appsettings.Production.json)",
      "Read(./**/secrets.json)",
      "Read(./**/nfceConfig.ini)"
    ]
  }
}
